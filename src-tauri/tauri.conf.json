{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TLX Control",
  "version": "2.0.0",
  "identifier": "it.tt-group.tlx-control",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TLX Control — TT Group",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "TT Group SRL",
    "copyright": "© TT Group SRL",
    "category": "Utility",
    "shortDescription": "Comando matrici Thinklogical TLX",
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } },
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
